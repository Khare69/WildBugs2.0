# Server Configuration
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Database Configuration (PostgreSQL with PostGIS)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wildbugs_db?schema=public"

# Authentication
JWT_SECRET="super-secret-development-jwt-token-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Redis Cache
REDIS_URL="redis://localhost:6379"

# External Integrations (Cloudinary & Google Cloud Vision)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
GOOGLE_APPLICATION_CREDENTIALS=""
